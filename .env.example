# Copy to .env; npm run dev loads it automatically (Node 24).
# 复制为 .env；npm run dev 自动读取。不要提交密钥 / Never commit secrets.
# fake: no external model calls; chat sending is disabled.
# fake：不调用外部模型，聊天发送关闭。免密钥交互请用 npm run dev:fixture。
BLACKX_RUNTIME_MODE=fake
BLACKX_PORT=5173
# 仅在运行旧版 HTTP Online Eval 时开启；日常产品入口保持关闭。
# BLACKX_ENABLE_RUNTIME_EVAL=1
# BLACKX_WORKSPACE_ROOT=.
# BLACKX_INSPECTION_CACHE_PATH=.blackx-data/inspection-cache

# Proposal Run 命令 API 默认关闭；启用时必须通过服务端环境注入高熵 Token。
# BLACKX_COMMAND_API_TOKEN=
# BLACKX_WORKER_API_TOKEN=
# BLACKX_EVENT_STORE_PATH=.blackx-data/events.json
# BLACKX_ARTIFACT_STORE_PATH=.blackx-data/artifacts
# BLACKX_ATTACHMENT_STORE_PATH=.blackx-data/attachments
# BLACKX_FILE_STORE_PATH=.blackx-data/files
# BLACKX_AGENT_STATE_PATH=.blackx-data/agent
# BLACKX_STAGE_JOB_QUEUE_PATH=.blackx-data/stage-jobs.json
# BLACKX_CRON_SCHEDULE_PATH=.blackx-data/cron-schedules.json
# BLACKX_STAGE_JOB_QUEUE_DRIVER=file
# BLACKX_WORKER_ID=local-worker-1
# BLACKX_WORKER_LEASE_MS=135000
# BLACKX_WORKER_POLL_MS=250
# BLACKX_OPERATOR_API_TOKEN=replace-with-a-different-32-byte-secret

# For real chat, change BLACKX_RUNTIME_MODE above to anthropic and fill all three values.
# 真实聊天：将上方模式改为 anthropic，并取消下面三个变量的注释、填写有效值。
# Base URL is the service root; Blackx appends /v1/messages.
# BASE_URL 填服务根地址；MODEL 填服务实际支持的模型 ID。
# Shell environment takes precedence over .env / 已有终端环境变量优先于 .env。
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MODEL=
# ANTHROPIC_API_KEY=
# Context limits are TOKENS, not characters. The official DeepSeek Flash endpoint
# defaults to the published 1,000,000-token capacity; Packx still caps input at 100,000.
# Balanced starting point: compact at 70,000 toward 45,000; change only after evaluation.
# PACKX_MODEL_CONTEXT_TOKENS=1000000
# PACKX_MODEL_MAX_OUTPUT_TOKENS=4096
# PACKX_CONTEXT_SAFETY_TOKENS=8192
# PACKX_MAX_INPUT_TOKENS=100000
# PACKX_COMPACT_TRIGGER_TOKENS=70000
# PACKX_COMPACT_TARGET_TOKENS=45000
# Optional: relocate the complete local data directory (existing per-store overrides take precedence).
# BLACKX_DATA_ROOT=.blackx-data
