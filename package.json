{
	"name": "packx",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "node --env-file-if-exists=.env --import tsx server/index.ts",
		"start": "npm run dev",
		"doctor": "node --env-file-if-exists=.env --import tsx scripts/doctor.ts",
		"state": "node --env-file-if-exists=.env --import tsx scripts/local-state.ts",
		"dev:web": "vite",
		"build": "tsc -b && vite build",
		"test": "vitest run",
		"test:watch": "vitest",
		"eval:memory": "node --import tsx eval/memory.ts",
		"eval:knowledge-enrich": "node --import tsx eval/knowledgeEnrich.ts",
		"eval:context": "node --import tsx eval/context.ts",
		"eval:recovery": "node --import tsx eval/reliabilityRecovery.ts",
		"eval:offline": "node --import tsx eval/run.ts",
		"eval:online": "node --import tsx eval/run.ts --online",
		"eval:m1": "node --import tsx eval/m1Research.ts",
		"eval:m1-online": "node --import tsx eval/m1Research.ts --online",
		"eval:knowledge": "node --import tsx eval/knowledge.ts",
		"demo:knowledge": "node --import tsx eval/knowledgeDemo.ts",
		"eval:plan": "node --import tsx eval/planSubagents.ts",
		"eval:loop-safety": "node --import tsx eval/loopSafety.ts",
		"eval:m2": "node --import tsx eval/m2RequirementBrief.ts",
		"eval:anthropic-contract": "node --import tsx eval/anthropicContract.ts",
		"check": "npm run test && npm run build",
		"build:native": "node scripts/build-native.mjs",
		"predev": "npm run build:native",
		"test:native": "BLACKX_RUN_SEATBELT_TESTS=1 vitest run server/runtime/macOsSeatbeltSandboxedToolExecutor.test.ts server/runtime/assetInspection.test.ts server/runtime/documentRead.test.ts",
		"eval:product": "node --import tsx eval/productSmoke.ts",
		"dev:fixture": "npm run build:native && node --import tsx eval/productSmoke.ts --serve",
		"check:local": "npm run check && npm run eval:offline && npm run eval:m1 && npm run eval:m2 && npm run eval:plan && npm run eval:loop-safety && npm run eval:context && npm run eval:recovery && npm run eval:memory && npm run build:native && npm run test:native && npm run eval:product",
		"release": "npm run build && npm run build:native && node scripts/build-release.mjs",
		"start:release": "node scripts/launch.mjs",
		"eval:release": "node --import tsx eval/releaseSmoke.ts",
		"knowledge:fetch": "node --import tsx eval/knowledgeFetch.ts",
		"knowledge:model": "node --import tsx eval/knowledgeModelPrepare.ts",
		"eval:knowledge-real": "node --import tsx eval/knowledgeReal.ts",
		"eval:knowledge-optimize": "node --import tsx eval/knowledgeOptimize.ts",
		"eval:knowledge-compare": "node --import tsx eval/knowledgeCompare.ts",
		"eval:knowledge-chunking": "node --import tsx eval/knowledgeChunking.ts",
		"eval:knowledge-sentence": "node --import tsx eval/knowledgeSentence.ts",
		"eval:knowledge-overlap": "node --import tsx eval/knowledgeReplay.ts v3",
		"knowledge:connect-products": "npm run build && node --env-file-if-exists=.env --import tsx eval/knowledgeConnect.ts --products",
		"knowledge:reranker": "node --import tsx eval/knowledgeRerankPrepare.ts",
		"eval:knowledge-replay": "node --import tsx eval/knowledgeReplay.ts",
		"knowledge:connect": "npm run build && node --env-file-if-exists=.env --import tsx eval/knowledgeConnect.ts"
	},
	"dependencies": {
		"@huggingface/transformers": "4.3.0",
		"@vitejs/plugin-react": "^5.0.0",
		"croner": "10.0.1",
		"fast-xml-parser": "5.11.1",
		"marked": "18.0.11",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"vite": "^7.0.0"
	},
	"devDependencies": {
		"@types/node": "^26.3.0",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"tsx": "4.23.12",
		"typescript": "^5.8.0",
		"vitest": "^4.0.0"
	},
	"engines": {
		"node": ">=24.14.0 <25"
	}
}
